# Main Provider API Configuration (e.g. provod.ai)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.provod.ai/v1

# Speech-to-Text Dedicated Provider Configuration (ProxyAPI)
STT_API_KEY=your_proxyapi_key_here
STT_BASE_URL=https://api.proxyapi.ru/openai/v1
STT_MODEL=gpt-4o-mini-transcribe

# Main Chat & Fast Models Configuration
DEFAULT_MODEL=openai/gpt-5.6-luna
FAST_MODEL=deepseek/deepseek-v4-flash

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://wegeny_admin:wegeny_password@localhost:5432/lifeos_db

# Telegram Bot Credentials & Single-User Access
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
ALLOWED_TELEGRAM_ID=123456789
